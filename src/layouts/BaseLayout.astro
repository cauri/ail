---
import { baseUrl } from '../utils/base-url';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
}

const { title, description = "AI Launchpad — a diagnostic framework for organizations navigating AI adoption.", ogType = "website" } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://cauri.github.io/ail');
const pageTitle = `${title} | AIL`;

import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/svg+xml" href={baseUrl("/favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-white text-primary antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-magenta focus:px-4 focus:py-2 focus:text-white">
      Skip to main content
    </a>
    <slot />
    <script>
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;

        // Close lightbox when clicking overlay
        if (target.closest('.lightbox-overlay')) {
          const overlay = target.closest('.lightbox-overlay') as HTMLElement;
          overlay.removeAttribute('data-visible');
          setTimeout(() => overlay.remove(), 200);
          return;
        }

        // Open lightbox when clicking a zoomable image
        // Matches: any img inside .prose, or any img/svg with data-zoomable
        const img = (target.closest('.prose img') || target.closest('img[data-zoomable]') || target.closest('[data-zoomable] img')) as HTMLImageElement | null;
        if (!img) return;

        const overlay = document.createElement('div');
        overlay.className = 'lightbox-overlay';
        overlay.setAttribute('role', 'dialog');
        overlay.setAttribute('aria-label', img.alt || 'Enlarged image');

        const clone = document.createElement('img');
        clone.src = img.src;
        clone.alt = img.alt;
        overlay.appendChild(clone);
        document.body.appendChild(overlay);

        // Trigger transition
        requestAnimationFrame(() => overlay.setAttribute('data-visible', ''));

        // Close on Escape
        const onKey = (ev: KeyboardEvent) => {
          if (ev.key === 'Escape') {
            overlay.removeAttribute('data-visible');
            setTimeout(() => overlay.remove(), 200);
            document.removeEventListener('keydown', onKey);
          }
        };
        document.addEventListener('keydown', onKey);
      });
    </script>
  </body>
</html>
