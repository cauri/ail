---
interface Step {
  number: string;
  title: string;
  description: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<section class="bg-white px-6 py-20">
  <div class="mx-auto max-w-5xl">
    <h2 class="text-center font-heading text-3xl text-primary">How It Works</h2>
    <p class="mx-auto mt-4 max-w-2xl text-center text-gray-500">
      A structured process to diagnose, plan, and accelerate your AI adoption journey.
    </p>
    <div class="mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      {steps.map((step) => (
        <div class="relative">
          <span class="font-heading text-5xl font-normal tracking-tight text-lavender">
            {step.number}
          </span>
          <h3 class="mt-2 font-heading text-lg text-primary">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-500">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
