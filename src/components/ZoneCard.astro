---
interface Props {
  zone: number;
  title: string;
  description: string;
  href?: string;
}

const { zone, title, description, href } = Astro.props;

const colors: Record<number, string> = {
  1: 'border-l-blue-400',
  2: 'border-l-emerald-400',
  3: 'border-l-amber-400',
  4: 'border-l-purple-400',
};
---

<a
  href={href || `/zones#zone-${zone}`}
  class:list={[
    "group block rounded-xl border border-gray-200 bg-gray-50 p-6 transition-shadow hover:shadow-md",
    "border-l-4",
    colors[zone] || "border-l-gray-400",
  ]}
>
  <p class="text-xs font-medium uppercase tracking-wider text-gray-500">Zone {zone}</p>
  <h3 class="mt-2 font-heading text-xl text-primary">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-gray-500">{description}</p>
  <span class="mt-4 inline-block text-sm font-medium text-magenta group-hover:text-pink">
    Learn more &rarr;
  </span>
</a>
