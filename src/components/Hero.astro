---
interface Props {
  title?: string;
  subtitle: string;
  ctaText?: string;
  ctaHref?: string;
}

const { title, subtitle, ctaText, ctaHref } = Astro.props;
---

<section class="bg-white px-6 py-24 md:py-32">
  <div class="mx-auto max-w-4xl text-center">
    <h1 class="font-heading text-4xl font-normal leading-tight tracking-[-0.06em] text-primary md:text-6xl">
      {title ? title : <slot name="title" />}
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-gray-500 md:text-xl">
      {subtitle}
    </p>
    {ctaText && ctaHref && (
      <div class="mt-10">
        <a
          href={ctaHref}
          class="inline-block rounded-full bg-magenta px-8 py-3.5 text-base font-medium text-white transition-colors hover:bg-pink"
        >
          {ctaText}
        </a>
      </div>
    )}
  </div>
</section>
