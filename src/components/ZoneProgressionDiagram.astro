---

---

<section class="bg-lavender px-6 py-20 overflow-hidden">
  <div class="mx-auto max-w-5xl">
    <h2 class="text-center font-heading text-3xl text-primary">The Journey</h2>
    <p class="mx-auto mt-4 max-w-2xl text-center text-gray-500">
      Four zones. Each one a different relationship with AI.
      Organizations choose how far to go based on strategic context.
    </p>

    <!-- Progression track -->
    <div class="relative mt-14">
      <!-- Connecting line (desktop) -->
      <div class="absolute left-0 right-0 top-[3.25rem] hidden h-0.5 bg-gradient-to-r from-blue-300 via-emerald-300 via-50% to-amber-300 md:block" aria-hidden="true"></div>

      <div class="grid gap-6 md:grid-cols-4">
        <!-- Zone 1 -->
        <a href="#zone-1" class="group relative block">
          <div class="relative z-10 mx-auto flex h-[6.5rem] w-[6.5rem] items-center justify-center rounded-2xl border-2 border-blue-400 bg-blue-50 shadow-sm transition-transform group-hover:-translate-y-1 group-hover:shadow-md">
            <div class="text-center">
              <p class="text-2xl font-heading text-blue-600">1</p>
              <p class="text-[10px] font-medium uppercase tracking-wider text-blue-500">Augmenting</p>
            </div>
          </div>
          <div class="mt-4 text-center">
            <p class="font-heading text-sm text-primary">Personal tools</p>
            <p class="mt-1 text-xs leading-relaxed text-gray-500">"I use AI in my daily work"</p>
          </div>
        </a>

        <!-- Zone 2 -->
        <a href="#zone-2" class="group relative block">
          <div class="relative z-10 mx-auto flex h-[6.5rem] w-[6.5rem] items-center justify-center rounded-2xl border-2 border-emerald-400 bg-emerald-50 shadow-sm transition-transform group-hover:-translate-y-1 group-hover:shadow-md">
            <div class="text-center">
              <p class="text-2xl font-heading text-emerald-600">2</p>
              <p class="text-[10px] font-medium uppercase tracking-wider text-emerald-500">Integrating</p>
            </div>
          </div>
          <div class="mt-4 text-center">
            <p class="font-heading text-sm text-primary">Shared workflow</p>
            <p class="mt-1 text-xs leading-relaxed text-gray-500">"We have a shared AI practice"</p>
          </div>
          <div class="mx-auto mt-2 w-fit rounded-full bg-emerald-100 px-2.5 py-0.5">
            <p class="text-[10px] font-medium text-emerald-700">Common starting target</p>
          </div>
        </a>

        <!-- Zone 3 -->
        <a href="#zone-3" class="group relative block">
          <div class="relative z-10 mx-auto flex h-[6.5rem] w-[6.5rem] items-center justify-center rounded-2xl border-2 border-amber-400 bg-amber-50 shadow-sm transition-transform group-hover:-translate-y-1 group-hover:shadow-md">
            <div class="text-center">
              <p class="text-2xl font-heading text-amber-600">3</p>
              <p class="text-[10px] font-medium uppercase tracking-wider text-amber-500">Accelerating</p>
            </div>
          </div>
          <div class="mt-4 text-center">
            <p class="font-heading text-sm text-primary">AI drives the work</p>
            <p class="mt-1 text-xs leading-relaxed text-gray-500">"We design how AI builds software"</p>
          </div>
        </a>

        <!-- Zone 4 -->
        <a href="#zone-4" class="group relative block">
          <div class="relative z-10 mx-auto flex h-[6.5rem] w-[6.5rem] items-center justify-center rounded-2xl border-2 border-purple-400 bg-purple-50 shadow-sm transition-transform group-hover:-translate-y-1 group-hover:shadow-md">
            <div class="text-center">
              <p class="text-2xl font-heading text-purple-600">4</p>
              <p class="text-[10px] font-medium uppercase tracking-wider text-purple-500">Industrializing</p>
            </div>
          </div>
          <div class="mt-4 text-center">
            <p class="font-heading text-sm text-primary">AI-first factory</p>
            <p class="mt-1 text-xs leading-relaxed text-gray-500">"AI is how we produce software"</p>
          </div>
        </a>
      </div>
    </div>

  </div>
</section>
