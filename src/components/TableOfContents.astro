---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{toc.length > 0 && (
  <div class="hidden xl:block">
    <div class="sticky top-20 w-56">
      <p class="text-xs font-medium uppercase tracking-wider text-gray-500">On this page</p>
      <ul class="mt-3 space-y-2 border-l border-gray-200">
        {toc.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              class:list={[
                "block border-l-2 border-transparent py-0.5 text-sm text-gray-500 transition-colors hover:border-magenta hover:text-primary",
                heading.depth === 2 ? "pl-4" : "pl-8",
              ]}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
)}
