---
interface Props {
  heading: string;
  description: string;
  buttonText: string;
  buttonHref: string;
  variant?: 'lavender' | 'light-blue';
}

const { heading, description, buttonText, buttonHref, variant = 'lavender' } = Astro.props;
const bgClass = variant === 'light-blue' ? 'bg-light-blue' : 'bg-lavender';
---

<section class:list={[bgClass, "px-6 py-20"]}>
  <div class="mx-auto max-w-3xl text-center">
    <h2 class="font-heading text-3xl text-primary">{heading}</h2>
    <p class="mt-4 text-gray-500">{description}</p>
    <div class="mt-8">
      <a
        href={buttonHref}
        class="inline-block rounded-full bg-magenta px-8 py-3.5 text-base font-medium text-white transition-colors hover:bg-pink"
      >
        {buttonText}
      </a>
    </div>
  </div>
</section>
