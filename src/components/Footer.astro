---
import { baseUrl } from '../utils/base-url';

const year = new Date().getFullYear();
---

<footer class="border-t border-gray-200 bg-white">
  <div class="mx-auto max-w-7xl px-6 py-12">
    <div class="grid gap-8 md:grid-cols-4">
      <div>
        <p class="font-heading text-lg font-medium text-primary">ACE</p>
        <p class="mt-2 text-sm text-gray-500">
          AI Competency Evaluation. A diagnostic
          framework by Artium.
        </p>
      </div>

      <div>
        <p class="text-sm font-medium text-primary">Framework</p>
        <ul class="mt-3 space-y-2">
          <li><a href={baseUrl("/#what-ace-measures")} class="text-sm text-gray-500 hover:text-primary">What ACE Measures</a></li>
          <li><a href={baseUrl("/#zones")} class="text-sm text-gray-500 hover:text-primary">Zones</a></li>
          <li><a href={baseUrl("/#how-it-works")} class="text-sm text-gray-500 hover:text-primary">How It Works</a></li>
        </ul>
      </div>

      <div>
        <p class="text-sm font-medium text-primary">Resources</p>
        <ul class="mt-3 space-y-2">
          <li><a href={baseUrl("/toolkit")} class="text-sm text-gray-500 hover:text-primary">Facilitator Toolkit</a></li>
          <li><a href={baseUrl("/training")} class="text-sm text-gray-500 hover:text-primary">Training Program</a></li>
          <li><a href={baseUrl("/research")} class="text-sm text-gray-500 hover:text-primary">Research</a></li>
        </ul>
      </div>

      <div>
        <p class="text-sm font-medium text-primary">Links</p>
        <ul class="mt-3 space-y-2">
          <li><a href="https://artium.ai" target="_blank" rel="noopener" class="text-sm text-gray-500 hover:text-primary">artium.ai</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-gray-200 pt-6 text-center text-sm text-gray-500">
      &copy; {year} Artium. All rights reserved.
    </div>
  </div>
</footer>
