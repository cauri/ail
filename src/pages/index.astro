---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import ZoneProgressionDiagram from '../components/ZoneProgressionDiagram.astro';
import SectionNav from '../components/SectionNav.astro';
import { baseUrl } from '../utils/base-url';

const zones = [
  {
    id: "zone-1",
    zone: 1,
    title: "Augmenting",
    shift: "Tool adoption shift",
    metric: "Team members across all roles habitually use AI tools in their daily work, even under deadline pressure or in unfamiliar territory.",
    description: "Individuals across engineering, product, design, and QA use AI assistants habitually as part of their daily work. AI usage is personal, optional, and ad-hoc.",
    color: "border-l-blue-400",
    bgColor: "bg-blue-50",
    toolkitHref: "/toolkit/zone-1-augmenting",
    roadmapHref: "/toolkit/baseline-to-zone-1",
  },
  {
    id: "zone-2",
    zone: 2,
    title: "Integrating",
    shift: "Workflow integration shift",
    metric: "The team ships AI-verified, production-ready work using a shared agentic workflow that all members — engineering, product, design, QA — contribute to and evolve.",
    description: "AI is embedded in team-level workflows across all roles: code review, testing, documentation, design systems, and CI/CD. Usage is systematic, not ad-hoc. The team has a shared, evolving agentic setup.",
    color: "border-l-emerald-400",
    bgColor: "bg-emerald-50",
    toolkitHref: "/toolkit/zone-2-integrating",
    roadmapHref: "/toolkit/zone-1-to-2",
  },
  {
    id: "zone-3",
    zone: 3,
    title: "Accelerating",
    shift: "Role identity shift",
    metric: "Engineers operate as process designers, PMs as behavioral specifiers, designers as design systems architects, and QA as evaluation pipeline specialists — each role defines inputs to the AI pipeline, which produces working software.",
    description: "AI drives core development work. All roles shift: engineers specify and verify, PMs define behavioral envelopes, designers encode standards as machine-verifiable inputs, QA designs evaluation infrastructure. Humans orchestrate; AI implements.",
    color: "border-l-amber-400",
    bgColor: "bg-amber-50",
    toolkitHref: "/toolkit/zone-3-accelerating",
    roadmapHref: "/toolkit/zone-2-to-3",
  },
  {
    id: "zone-4",
    zone: 4,
    title: "Industrializing",
    shift: "Production model shift",
    metric: "The organization can reliably specify, produce, evaluate, and deploy AI-generated software at scale, with all production roles operating in factory mode — engineers as factory designers, PMs as portfolio specifiers, designers as specification layer owners, QA as evaluation operators.",
    description: "The organization operates an AI-first software factory. Engineers maintain the factory, PMs define production targets, designers own the specification layer, QA operates evaluation infrastructure. AI produces the software.",
    color: "border-l-purple-400",
    bgColor: "bg-purple-50",
    toolkitHref: "/toolkit/zone-4-industrializing",
    roadmapHref: "/toolkit/zone-3-to-4",
  },
];

const assessmentPhases = [
  {
    number: "01",
    title: "Discovery",
    description: "Build a thorough understanding of the client organization's context — size, development maturity, current AI usage, competitive position, and stakeholder perspectives — before administering any diagnostic.",
    decision: "At this point, the client has a complete context analysis.",
  },
  {
    number: "02",
    title: "Diagnostic",
    description: "A trained Artium facilitator guides client teams through structured self-assessments to establish their current zone and competency stage. This is collaborative, not an external audit.",
    decision: "At this point, the client has a full diagnostic picture. They can proceed independently or continue to goal setting.",
  },
  {
    number: "03",
    title: "Goal Setting & Roadmap",
    description: "Client leadership reviews results and chooses target zones based on strategic context. Artisans help build progression plans with specific investments, timelines, and leading indicators.",
    decision: "At this point, the client has a detailed progression plan with clear investments and leading indicators.",
  },
];
---

<PageLayout title="AI Competency Evaluation" description="Internal reference for Artium's AI Competency Evaluation framework — zones, diagnostics, facilitation tools, and delivery methodology.">
  <Hero
    subtitle="ACE is Artium's framework for assessing AI competency in client organizations, setting meaningful progression goals, and building real capability through embedded delivery."
    ctaText="Explore the Framework"
    ctaHref={baseUrl("/toolkit")}
  >
    <Fragment slot="title">Assess Where They Are.<br />Guide Where They're Going.</Fragment>
  </Hero>

  <SectionNav />

  <!-- Section 2: The Problem -->
  <section id="the-problem" class="bg-lavender px-6 py-20">
    <div class="mx-auto max-w-3xl">
      <h2 class="font-heading text-3xl text-primary">The Problem ACE Solves</h2>
      <p class="mt-4 text-gray-500">
        Client organizations are using AI tools. But are they competent? ACE helps move beyond anecdotes and impressions to understand where teams actually are, and what investments will move them forward.
      </p>
      <div class="mt-8 space-y-6">
        <div class="rounded-xl bg-white p-6">
          <h3 class="font-heading text-lg text-primary">Organizations don't know where they are</h3>
          <p class="mt-2 text-gray-500">
            Leadership hears "we're using AI" but has no way to assess whether that usage is habitual, effective, or integrated into delivery workflows. Individual enthusiasm is confused with organizational capability.
          </p>
        </div>
        <div class="rounded-xl bg-white p-6">
          <h3 class="font-heading text-lg text-primary">Organizations don't know where to go</h3>
          <p class="mt-2 text-gray-500">
            AI maturity models suggest that more is always better, pushing organizations toward ambitious transformation goals that may not match their strategic needs, risk tolerance, or investment capacity.
          </p>
        </div>
        <div class="rounded-xl bg-white p-6">
          <h3 class="font-heading text-lg text-primary">Organizations don't know how to get there</h3>
          <p class="mt-2 text-gray-500">
            Even organizations with clear goals lack a structured approach to identifying and making the specific investments — organizational, not just individual — required to reach the next level of AI integration. ACE addresses this gap: Artisans embed with client teams to help make it happen through collaborative delivery.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: What ACE Measures -->
  <section id="what-ace-measures" class="bg-white px-6 py-20">
    <div class="mx-auto max-w-3xl">
      <h2 class="font-heading text-3xl text-primary">Competency, Not Knowledge</h2>
      <p class="mt-6 text-lg leading-relaxed text-gray-500">
        The word "competency" in ACE is intentional. Competency means habitual behavior under stress — not knowledge about best practices, and not performance on a team's best day.
      </p>
      <p class="mt-4 text-gray-500">
        A team that knows how to integrate AI into their CI/CD pipeline but abandons that practice when a deadline tightens is not competent. A developer who uses AI tools impressively during a demo but reverts to manual coding under pressure is not competent. Competency is what you do reliably, even when conditions are unfavorable.
      </p>

      <h3 class="mt-12 font-heading text-2xl text-primary">How ACE Differs from Maturity Models</h3>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b-2 border-gray-200">
              <th class="py-3 pr-6 text-left font-medium text-primary">Maturity Models</th>
              <th class="py-3 text-left font-medium text-primary">ACE</th>
            </tr>
          </thead>
          <tbody class="text-gray-500">
            <tr class="border-b border-gray-200">
              <td class="py-3 pr-6">Higher is always better</td>
              <td class="py-3">Higher requires more investment; choose what fits</td>
            </tr>
            <tr class="border-b border-gray-200">
              <td class="py-3 pr-6">Measures knowledge and processes</td>
              <td class="py-3">Measures habitual behavior under pressure</td>
            </tr>
            <tr class="border-b border-gray-200">
              <td class="py-3 pr-6">External audit / checklist</td>
              <td class="py-3">Facilitated team self-assessment</td>
            </tr>
            <tr class="border-b border-gray-200">
              <td class="py-3 pr-6">Point-in-time snapshot</td>
              <td class="py-3">Continuous improvement cycle</td>
            </tr>
            <tr>
              <td class="py-3 pr-6">Technology-focused</td>
              <td class="py-3">Organizational investment-focused</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-6 text-sm text-gray-500">
        <a href={baseUrl("/research")} class="text-magenta hover:text-pink underline">See the research basis</a> for ACE's measurement philosophy.
        Note: these claims are grounded in the Agile Fluency Model and DORA research but have not yet been validated for ACE's specific instrument. See the <a href={baseUrl("/research/validation-study-plan")} class="text-magenta hover:text-pink underline">validation study plan</a> for the empirical calibration roadmap.
      </p>
    </div>
  </section>

  <!-- Section 4: Zone Progression Diagram -->
  <section id="zones" class="scroll-mt-20">
    <ZoneProgressionDiagram />
  </section>

  <!-- Section 5: Zone Details -->
  {zones.map((z) => (
    <section id={z.id} class:list={[z.zone % 2 === 0 ? "bg-gray-50" : "bg-white", "scroll-mt-20 px-6 py-20"]}>
      <div class="mx-auto max-w-4xl">
        <div class:list={["rounded-xl border-l-4 bg-white p-8 shadow-sm", z.color]}>
          <p class="text-xs font-medium uppercase tracking-wider text-gray-500">
            Zone {z.zone} &middot; {z.shift}
          </p>
          <h2 class="mt-2 font-heading text-3xl text-primary">{z.title}</h2>
          <p class="mt-4 text-gray-500">{z.description}</p>

          <div class="mt-8 rounded-lg bg-gray-50 p-5">
            <p class="text-xs font-medium uppercase tracking-wider text-gray-500">Core Metric</p>
            <p class="mt-2 text-sm font-medium text-primary">{z.metric}</p>
          </div>

          <div class="mt-6 flex flex-wrap gap-4 text-sm">
            <a href={baseUrl(z.toolkitHref)} class="text-magenta hover:text-pink underline">
              See Zone {z.zone} proficiencies in the Toolkit
            </a>
            <a href={baseUrl(z.roadmapHref)} class="text-magenta hover:text-pink underline">
              Zone {z.zone > 1 ? `${z.zone - 1} to ${z.zone}` : "Baseline to 1"} progression roadmap
            </a>
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- Section 6: Strategic Choice -->
  <section id="choose-your-depth" class="bg-white px-6 py-20">
    <div class="mx-auto max-w-3xl">
      <h2 class="font-heading text-3xl text-primary">A Progressive Path, Not a Mandate</h2>
      <p class="mt-6 text-gray-500">
        ACE defines a single linear progression through four zones, each building on the previous. Organizations choose how far along this path to travel based on their strategic context, investment capacity, and risk appetite.
      </p>
      <p class="mt-4 text-gray-500">
        Zone 2 is the typical near-term target for most organizations — it represents the competitive baseline. Zones 3 and 4 require progressively larger investments justified only in certain strategic contexts.
      </p>

      <div class="mt-10 rounded-xl border border-gray-200 bg-gray-50 p-6 text-center shadow-sm">
        <p class="text-sm font-medium text-primary">
          Higher isn't always better.
        </p>
        <p class="mt-2 text-sm text-gray-500">
          A deeply competent Zone 2 organization that chose its destination through careful analysis
          is in a stronger position than a Zone 4 organization that overextended.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 7: How It Works -->
  <section id="how-it-works" class="bg-lavender px-6 py-20">
    <div class="mx-auto max-w-4xl">
      <h2 class="font-heading text-3xl text-primary">How It Works</h2>
      <p class="mx-auto mt-4 max-w-2xl text-gray-500">
        Two tracks run concurrently. Facilitators build the diagnostic and roadmap while Artisans embed with the team to deliver real software and build foundational capability from day one.
      </p>

      <div class="mt-10 grid gap-8 md:grid-cols-2">
        <!-- Assessment Track -->
        <div>
          <div class="mb-4 flex items-center gap-2">
            <span class="rounded-full bg-magenta/10 px-3 py-1 text-xs font-medium text-magenta">Assessment Track</span>
            <span class="text-xs text-gray-400">Facilitator-led</span>
          </div>
          <div class="space-y-4">
            {assessmentPhases.map((phase) => (
              <div>
                <div class="rounded-xl bg-white p-5 shadow-sm">
                  <div class="flex items-start gap-3">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-lavender font-heading text-xs font-medium text-magenta">
                      {phase.number}
                    </span>
                    <div>
                      <h3 class="font-heading text-base text-primary">{phase.title}</h3>
                      <p class="mt-1.5 text-sm text-gray-500">{phase.description}</p>
                    </div>
                  </div>
                </div>
                {phase.decision && (
                  <div class="ml-4 mt-1.5 flex items-center gap-2 border-l-2 border-magenta/30 py-1.5 pl-3">
                    <svg class="h-3.5 w-3.5 shrink-0 text-magenta" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                    <p class="text-xs font-medium text-gray-500">{phase.decision}</p>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>

        <!-- Delivery Track -->
        <div>
          <div class="mb-4 flex items-center gap-2">
            <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-medium text-emerald-700">Delivery Track</span>
            <span class="text-xs text-gray-400">Runs concurrently</span>
          </div>
          <div class="rounded-xl border-2 border-dashed border-emerald-300 bg-white p-5 shadow-sm">
            <h3 class="font-heading text-base text-primary">Collaborative Delivery</h3>
            <p class="mt-2 text-sm text-gray-500">
              Experienced Artisans — engineers, product managers, and designers — embed with client teams from the start. They deliver real software shoulder-to-shoulder while assessing and strengthening the foundational practices (TDD, pair programming, continuous integration, small iterations) that teams need before AI-augmented workflows can take hold.
            </p>
            <p class="mt-3 text-sm text-gray-500">
              This is not sequential — Artisans don't wait for the roadmap to start helping. While facilitators build the diagnostic and progression plan, the delivery team is already providing ground-truth signal about the team's capabilities and building "AI-ready" engineering habits through the shared work.
            </p>
            <p class="mt-3 text-sm text-gray-500">
              As assessment outputs arrive, they refine the Artisan team's focus. The roadmap doesn't initiate the work — it formalizes what's already underway and sets the direction forward.
            </p>
            <div class="mt-4 rounded-lg bg-emerald-50 p-3">
              <p class="text-xs font-medium text-emerald-800">
                Artisans complete intensive internal training through Artium Academy before joining the team, ensuring they bring tested practices to every engagement.
              </p>
            </div>
          </div>
        </div>
      </div>

      <p class="mt-8 text-sm text-gray-500">
        <a href={baseUrl("/training")} class="text-magenta hover:text-pink underline">Learn about facilitator certification</a> for the assessment and coaching methodology.
      </p>
    </div>
  </section>

  <!-- Section 8: What to Expect -->
  <section id="what-to-expect" class="bg-white px-6 py-20">
    <div class="mx-auto max-w-3xl">
      <h2 class="font-heading text-3xl text-primary">What to Expect</h2>
      <div class="mt-8 space-y-6">
        <div class="rounded-xl bg-gray-50 p-6">
          <h3 class="font-heading text-lg text-primary">Duration</h3>
          <p class="mt-2 text-gray-500">
            The assessment track (Discovery, Diagnostic, Roadmap) typically spans 6-9 weeks. Collaborative Delivery runs concurrently from the start and typically continues for 3-18 months total, with Artisans ramping down as the client team demonstrates competency through periodic re-assessment.
          </p>
        </div>
        <div class="rounded-xl bg-gray-50 p-6">
          <h3 class="font-heading text-lg text-primary">Who Participates</h3>
          <p class="mt-2 text-gray-500">
            Business leadership, engineering leadership, and individual contributors on the client side all play roles. The diagnostic involves development teams directly — typically 3-5 members per team in facilitated sessions. During Collaborative Delivery, Artisans join the client team as full members — working the same backlog, attending the same standups, and collaborating daily.
          </p>
        </div>
        <div class="rounded-xl bg-gray-50 p-6">
          <h3 class="font-heading text-lg text-primary">Deliverables</h3>
          <p class="mt-2 text-gray-500">
            The engagement produces a context analysis, team-level diagnostic reports, management summary, target zone recommendations, and a detailed progression roadmap. During Collaborative Delivery, the output is working software delivered shoulder-to-shoulder with experienced Artisans, plus a client team that has built real competency through the shared work.
          </p>
        </div>
      </div>
    </div>
  </section>

</PageLayout>
