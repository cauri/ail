---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const allDocs = await getCollection('research');
const sorted = allDocs.sort((a, b) => a.data.order - b.data.order);
---

<PageLayout title="Research" description="Research supporting the ACE framework, including literature reviews, validation study designs, and interview guides.">
  <section class="bg-white px-6 py-24">
    <div class="mx-auto max-w-4xl">
      <h1 class="font-heading text-4xl leading-tight tracking-[-0.06em] text-primary md:text-5xl">
        Research
      </h1>
      <p class="mt-6 text-lg text-gray-500">
        Research supporting the ACE framework, including literature reviews, validation study designs, and interview guides for expert, leadership, and practitioner validation.
      </p>
    </div>
  </section>

  <section class="bg-gray-50 px-6 py-20">
    <div class="mx-auto max-w-4xl space-y-4">
      {sorted.map((doc, index) => (
        <a
          href={`/research/${doc.id}`}
          class="group flex items-start gap-6 rounded-xl border border-gray-200 bg-white p-6 transition-shadow hover:shadow-md"
        >
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-lavender font-heading text-sm font-medium text-magenta">
            {index + 1}
          </span>
          <div class="min-w-0">
            <h3 class="font-heading text-lg text-primary group-hover:text-magenta">
              {doc.data.title}
            </h3>
            <p class="mt-1 text-sm text-gray-500">{doc.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

</PageLayout>
