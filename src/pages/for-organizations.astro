---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import EngagementSteps from '../components/EngagementSteps.astro';

const phases = [
  {
    number: "01",
    title: "Discovery",
    description: "We build a thorough understanding of your organization's context — size, development maturity, current AI usage, competitive position, and stakeholder perspectives — before administering any diagnostic.",
  },
  {
    number: "02",
    title: "Diagnostic",
    description: "A trained facilitator guides teams through structured self-assessments to establish their current zone and competency stage. This is collaborative, not an external audit.",
  },
  {
    number: "03",
    title: "Goal Setting & Roadmap",
    description: "Leadership reviews results and chooses target zones based on strategic context. We build progression plans with specific investments, timelines, and leading indicators.",
  },
  {
    number: "04",
    title: "Collaborative Delivery",
    description: "Experienced Artisans — engineers, product managers, and designers — embed with your teams to deliver real software together. Your team builds competency through the shared work, not through workshops or training sessions.",
  },
];
---

<MarketingLayout title="For Organizations" description="Why diagnose your AI competency, what to expect from the process, and how ACE engagements work.">
  <section class="bg-white px-6 py-24">
    <div class="mx-auto max-w-3xl">
      <h1 class="font-heading text-4xl leading-tight tracking-[-0.06em] text-primary md:text-5xl">
        For Organizations
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-gray-500">
        Your teams are using AI tools. But are they competent? ACE helps you move beyond anecdotes and impressions to understand where your teams actually are, and what investments will move them forward.
      </p>
    </div>
  </section>

  <section class="bg-lavender px-6 py-20">
    <div class="mx-auto max-w-3xl">
      <h2 class="font-heading text-3xl text-primary">Why Diagnose AI Competency?</h2>
      <div class="mt-8 space-y-4">
        <div class="flex items-start gap-4">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white text-sm font-medium text-magenta">1</div>
          <div>
            <h3 class="font-heading text-lg text-primary">Replace assumptions with data</h3>
            <p class="mt-1 text-gray-500">"We're using AI" is not a measurement. The diagnostic reveals whether AI usage is habitual and effective or sporadic and superficial.</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white text-sm font-medium text-magenta">2</div>
          <div>
            <h3 class="font-heading text-lg text-primary">Set realistic goals</h3>
            <p class="mt-1 text-gray-500">Not every team needs to reach Zone 4. The framework helps you choose a target zone that matches your strategic needs and investment capacity.</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white text-sm font-medium text-magenta">3</div>
          <div>
            <h3 class="font-heading text-lg text-primary">Focus investments</h3>
            <p class="mt-1 text-gray-500">Each zone requires specific organizational investments — not just training, but changes to workflows, infrastructure, and team structure. The roadmap tells you exactly where to invest.</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white text-sm font-medium text-magenta">4</div>
          <div>
            <h3 class="font-heading text-lg text-primary">Measure real progress</h3>
            <p class="mt-1 text-gray-500">Leading indicators and periodic re-assessment show whether investments are producing genuine competency — habitual behavior under pressure, not just training completion.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <EngagementSteps steps={phases} />

  <section class="bg-light-blue px-6 py-20">
    <div class="mx-auto max-w-3xl">
      <h2 class="font-heading text-3xl text-primary">What to Expect</h2>
      <div class="mt-8 space-y-6">
        <div class="rounded-xl bg-white p-6">
          <h3 class="font-heading text-lg text-primary">Duration</h3>
          <p class="mt-2 text-gray-500">
            Discovery and Diagnostic phases typically span 4-6 weeks. Roadmap development adds 2-3 weeks. Collaborative Delivery typically runs 3-18 months, with Artisans ramping down as your team demonstrates competency through periodic re-assessment.
          </p>
        </div>
        <div class="rounded-xl bg-white p-6">
          <h3 class="font-heading text-lg text-primary">Who Participates</h3>
          <p class="mt-2 text-gray-500">
            Business leadership, engineering leadership, and individual contributors all play roles. The diagnostic itself involves development teams directly — typically 3-5 members per team in facilitated sessions. During Collaborative Delivery, Artisans join your team as full members — working the same backlog, attending the same standups, and collaborating daily.
          </p>
        </div>
        <div class="rounded-xl bg-white p-6">
          <h3 class="font-heading text-lg text-primary">Deliverables</h3>
          <p class="mt-2 text-gray-500">
            You receive a context analysis, team-level diagnostic reports, management summary, target zone recommendations, and a detailed progression roadmap. During Collaborative Delivery, you get working software delivered shoulder-to-shoulder with experienced Artisans, plus a team that has built real competency through the shared work.
          </p>
        </div>
      </div>
    </div>
  </section>

</MarketingLayout>
