---
import MarketingLayout from '../layouts/MarketingLayout.astro';

const zones = [
  {
    id: "zone-1",
    zone: 1,
    title: "Augmenting",
    shift: "Tool adoption shift",
    metric: "Developers habitually use AI coding tools in their daily work, even under deadline pressure or in unfamiliar codebases.",
    description: "Individual developers use AI coding assistants — copilot, autocomplete, chat — habitually as part of their daily work. AI usage is personal, optional, and ad-hoc.",
    benefits: [
      "Faster individual task completion",
      "Reduced 'blank page' problem",
      "Faster onboarding to unfamiliar codebases",
      "Reduction in boilerplate coding time",
      "More time for higher-value thinking work",
      "Democratized access to coding help",
    ],
    color: "border-l-blue-400",
    bgColor: "bg-blue-50",
  },
  {
    id: "zone-2",
    zone: 2,
    title: "Integrating",
    shift: "Workflow integration shift",
    metric: "The team ships AI-verified, production-ready code using a shared agentic workflow that all members contribute to and evolve.",
    description: "AI is embedded in team-level workflows: code review, testing, documentation, and CI/CD. Usage is systematic, not ad-hoc. The team has a shared, evolving agentic setup.",
    benefits: [
      "Consistent code quality through systematic AI-assisted review",
      "Reduced knowledge silos",
      "Faster onboarding of new team members",
      "Measurable velocity improvements",
      "Reduced bug rates through mandatory feedback loops",
      "Team-level reliability independent of individual AI skill",
    ],
    color: "border-l-emerald-400",
    bgColor: "bg-emerald-50",
  },
  {
    id: "zone-3",
    zone: 3,
    title: "Accelerating",
    shift: "Role identity shift",
    metric: "Engineers operate as process designers — they define specifications, constraints, and verification criteria, and the AI pipeline produces working software.",
    description: "AI drives core development work. Humans specify, review, and orchestrate; AI implements. The developer role fundamentally changes from writing code to designing the process by which code is produced.",
    benefits: [
      "Dramatic throughput increase",
      "Better software quality through systematic evaluation",
      "Engineers work at a higher abstraction level",
      "Faster learning loops through experiment management",
      "AI system reliability through observability",
      "Cross-disciplinary competency",
    ],
    color: "border-l-amber-400",
    bgColor: "bg-amber-50",
  },
  {
    id: "zone-4",
    zone: 4,
    title: "Industrializing",
    shift: "Production model shift",
    metric: "The organization can reliably specify, produce, evaluate, and deploy AI-generated software at scale, with engineers operating as factory designers.",
    description: "The organization operates an AI-first software factory. Engineers maintain the factory; AI produces the software. Software delivery is treated as an industrial operation.",
    benefits: [
      "Extreme production throughput",
      "Highly consistent quality through systematic governance",
      "Rapid adaptation to changing requirements",
      "Organizational capability as competitive moat",
    ],
    color: "border-l-purple-400",
    bgColor: "bg-purple-50",
  },
];
---

<MarketingLayout title="Zones of AI Competency" description="Explore the four zones of AI Competency Evaluation, from individual augmentation to organizational industrialization.">
  <section class="bg-white px-6 py-24">
    <div class="mx-auto max-w-4xl text-center">
      <h1 class="font-heading text-4xl leading-tight tracking-[-0.06em] text-primary md:text-5xl">
        Four Zones of AI Competency
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-gray-500">
        Each zone represents a qualitatively different way that teams relate to AI in their software development practice. Teams progress through zones sequentially, each building on the habits established in the previous zone.
      </p>
    </div>
  </section>

  <section class="bg-lavender px-6 py-10">
    <div class="mx-auto max-w-5xl">
      <img
        src="/images/zone-progression-diagram.svg"
        alt="Zone progression diagram showing four zones of AI competency progressing left to right: Augmenting (individual), Integrating (team), Accelerating (role), and Industrializing (organization), with decision gates between each zone"
        class="mx-auto w-full max-w-5xl"
        data-zoomable
      />
    </div>
  </section>

  {zones.map((z) => (
    <section id={z.id} class:list={[z.zone % 2 === 0 ? "bg-gray-50" : "bg-white", "px-6 py-20"]}>
      <div class="mx-auto max-w-4xl">
        <div class:list={["rounded-xl border-l-4 bg-white p-8 shadow-sm", z.color]}>
          <p class="text-xs font-medium uppercase tracking-wider text-gray-500">
            Zone {z.zone} &middot; {z.shift}
          </p>
          <h2 class="mt-2 font-heading text-3xl text-primary">{z.title}</h2>
          <p class="mt-4 text-gray-500">{z.description}</p>

          <div class="mt-8 rounded-lg bg-gray-50 p-5">
            <p class="text-xs font-medium uppercase tracking-wider text-gray-500">Core Metric</p>
            <p class="mt-2 text-sm font-medium text-primary">{z.metric}</p>
          </div>

          <div class="mt-8">
            <p class="text-xs font-medium uppercase tracking-wider text-gray-500">Key Benefits</p>
            <ul class="mt-3 grid gap-2 sm:grid-cols-2">
              {z.benefits.map((benefit) => (
                <li class="flex items-start gap-2 text-sm text-gray-500">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-magenta" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {benefit}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  ))}

</MarketingLayout>
