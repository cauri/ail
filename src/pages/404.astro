---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <section class="flex min-h-[60vh] items-center justify-center px-6 py-24">
    <div class="text-center">
      <p class="font-heading text-6xl text-lavender">404</p>
      <h1 class="mt-4 font-heading text-3xl text-primary">Page not found</h1>
      <p class="mt-4 text-gray-500">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="mt-8 flex justify-center gap-4">
        <a
          href="/"
          class="rounded-full bg-magenta px-6 py-2.5 text-sm font-medium text-white transition-colors hover:bg-pink"
        >
          Go home
        </a>
        <a
          href="/toolkit"
          class="rounded-full border border-gray-200 px-6 py-2.5 text-sm font-medium text-primary transition-colors hover:border-gray-300"
        >
          Browse toolkit
        </a>
      </div>
    </div>
  </section>
</MarketingLayout>
